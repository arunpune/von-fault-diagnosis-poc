{
  "name": "fault-diagnosis-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace root: manual-grounded fault triage for a fictional compressed-air unit",
  "license": "Apache-2.0",
  "author": "Meddle S.r.l.",
  "repository": {
    "type": "git",
    "url": "https://github.com/meddleconnect/von-fault-diagnosis-poc"
  },
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "lint": "pnpm run lint:format && pnpm run lint:eslint && pnpm run typecheck && pnpm -r run typecheck",
    "lint:format": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs --output-type err apps packages tools",
    "fmt": "prettier --write . && eslint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm run test && pnpm -r run test"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "mqtt": "catalog:",
    "prettier": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}

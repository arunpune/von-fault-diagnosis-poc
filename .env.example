#
# Copy to .env (git-ignored). Uncomment a line to override its default.
# Only the two *_API_KEY variables are secrets; everything else is a PoC default.

## Decision backend
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# DECISION_BACKEND=            # jev | llm | rules  (jev when TYPESAFE_API_KEY is set, else rules)
# LLM_PROVIDER=anthropic
LLM_API_KEY=
# LLM_MODEL=claude-opus-5
# LLM_BASE_URL=            # Anthropic base URL override; the contracts mock sets it in tests
## Prices (Cost panel)
# USD per million tokens, as published by TypeSafe AI (Jev, output tokens free) and Anthropic (claude-opus-5), September 2026
# JEV_PRICE_INPUT_PER_MTOK=0.042
# LLM_PRICE_INPUT_PER_MTOK=5
# LLM_PRICE_OUTPUT_PER_MTOK=25
# PRICES_AS_OF=2026-09-19
## Data
# METROPT_URL=                 # default: the UCI zip; a planned project mirror will replace it
# METROPT_FALLBACK_URL=https://archive.ics.uci.edu/static/public/791/metropt+3+dataset.zip
# METROPT_CSV=/data/metropt3/MetroPT3(AirCompressor).csv   # CI and the faster replay use /data/fixtures/metropt3/ci-slice.csv
# METROPT_CSV_HOST=data/metropt3/MetroPT3(AirCompressor).csv   # host path `make fixtures` cuts from; read from the shell, not from .env (METROPT_CSV_HOST=/path/to/csv make fixtures)
# MANUAL_PATH=                 # default: data/manual/cau-7-realistic.pdf
# MODEL_CACHE_DIR=/models
## Init
# INIT_WAIT_TIMEOUT_S=120
# INIT_DOWNLOAD_TIMEOUT_S=3600
# INIT_FORCE_INGEST=0
## Simulation and ports
# REPLAY_SPEED=600
# UI_PORT=8080
# MQTT_PORT=1883
# MODBUS_PORT=5020
# POLL_INTERVAL_MS=50
## Postgres and broker credentials (non-secret PoC defaults)
# POSTGRES_USER=fdp_admin
# POSTGRES_PASSWORD=fdp_admin
# POSTGRES_DB=fdp
# PG_APP_PASSWORD=app_rw
# PG_GT_PASSWORD=gt_rw
# PG_EVAL_PASSWORD=eval
# MQTT_GATEWAY_PASSWORD=gateway
# MQTT_SIM_PASSWORD=sim
# MQTT_BACKEND_DIAG_PASSWORD=backend-diag
# MQTT_BACKEND_OPS_PASSWORD=backend-ops
# MQTT_EVAL_PASSWORD=eval
## Backend tuning
# HEARTBEAT_TELEMETRY_TIMEOUT_S=15
# HEARTBEAT_DECISION_TIMEOUT_S=60
# GATE_TICKET_MIN_CONFIDENCE=0.85
# GATE_REVIEW_MIN_CONFIDENCE=0.60
# GATE_PERSIST_SIM_MIN=1
# JEV_GATE_TICKET_MIN_CONFIDENCE=0.85        # Jev's own ticket threshold (the pre-registered choice); rules and llm keep GATE_*
# JEV_GATE_REVIEW_MIN_CONFIDENCE=0.65        # Jev's own review threshold (the pre-registered choice); rules and llm keep GATE_*
# DECISION_INTERVAL_SIM_MIN=30
# EPISODE_CLEAR_SIM_MIN=120
# TELEMETRY_RETENTION_SIM_DAYS=365
# LOG_LEVEL=info
# EMBEDDER_ALLOW_DOWNLOAD=false
# RULES_DISABLED=flow_pulses_missing
# WS_TELEMETRY_INTERVAL_MS=250
## Evaluation
# EVAL_PROFILE=core
# EVAL_JEV_MODE=auto

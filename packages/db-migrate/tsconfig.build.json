{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The emitting project: `pnpm run build` (`tsc -b tsconfig.build.json`)
  // writes src/ to dist/, which is what the `default` export condition
  // resolves to inside an image. Tests stay out of it.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}

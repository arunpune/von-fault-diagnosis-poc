{
  "name": "@fdp/db-migrate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plain-SQL forward-only migration runner for db/migrations, with a testcontainers helper",
  "license": "Apache-2.0",
  "author": "Meddle S.r.l.",
  "repository": {
    "type": "git",
    "url": "https://github.com/meddleconnect/von-fault-diagnosis-poc"
  },
  "exports": {
    ".": {
      "@fdp/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@fdp/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node --conditions=@fdp/source src/cli.ts migrate",
    "status": "node --conditions=@fdp/source src/cli.ts status"
  },
  "dependencies": {
    "pg": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

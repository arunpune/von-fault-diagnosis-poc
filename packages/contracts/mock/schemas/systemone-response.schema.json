{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fdp:mock:systemone-response:v1",
  "title": "POST /v1/systemone response body",
  "description": "The shape the mock answers with, and the shape a scripted answer is checked against before it leaves the server. Every answer carries `type`, so a consumer never has to guess which primitive it holds.",
  "type": "object",
  "required": ["model", "answers", "usage"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "answers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/answer" }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "entry": {
      "description": "The SDK's EntryType: text, a JSON object or array, or null.",
      "type": ["string", "object", "array", "null"]
    },
    "answer": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["noul", "choice", "score"] } },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "type": { "const": "noul" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/noul_answer" }
        },
        {
          "if": {
            "type": "object",
            "properties": { "type": { "const": "choice" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/choice_answer" }
        },
        {
          "if": {
            "type": "object",
            "properties": { "type": { "const": "score" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/score_answer" }
        }
      ]
    },
    "noul_answer": {
      "type": "object",
      "required": ["type", "noul"],
      "properties": {
        "type": { "const": "noul" },
        "noul": { "$ref": "#/$defs/probability" }
      },
      "additionalProperties": false
    },
    "choice_answer": {
      "type": "object",
      "required": ["type", "choice", "confidence", "probabilities"],
      "properties": {
        "type": { "const": "choice" },
        "choice": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/probability" },
        "probabilities": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/probability" }
        }
      },
      "additionalProperties": false
    },
    "score_answer": {
      "type": "object",
      "required": ["type", "score", "confidence", "legend", "probabilities"],
      "properties": {
        "type": { "const": "score" },
        "score": { "type": "number", "minimum": 0 },
        "confidence": { "$ref": "#/$defs/probability" },
        "legend": {
          "description": "The rubric keyed by level index. The SDK types each entry as the criterion itself (`ScoreLegend<T> = T[score]`), and the live API echoes a level exactly as it was asked: an object level comes back as that object. The mock's own default answers render a level as text (`summary` or JSON), so both shapes are legal here.",
          "type": "object",
          "minProperties": 2,
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/entry" }
        },
        "probabilities": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/probability" }
        }
      },
      "additionalProperties": false
    }
  }
}

#
# The UI's single server: the built app and, under the same origin, the
# backend's REST and WebSocket endpoints, so the browser never needs a second
# host or CORS and nothing leaves the origin.
#
# This is a template. At start-up the official image's entrypoint renders it to
# /etc/nginx/conf.d/default.conf (replacing the stock server on port 80) with
# envsubst, and the Dockerfile's NGINX_ENVSUBST_FILTER=^BACKEND_ limits the
# substitution to BACKEND_UPSTREAM, so nginx's own $uri and $http_upgrade below
# reach nginx untouched.

server {
  listen 8080;
  server_tokens off;
  root /usr/share/nginx/html;

  gzip on;
  gzip_vary on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Liveness of this container for its HEALTHCHECK and the Compose healthcheck.
  # Answered by nginx itself: the backend has a healthcheck of its own.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  location /api/ {
    proxy_pass http://${BACKEND_UPSTREAM}/api/;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
  }

  # The live channel is an HTTP/1.1 upgrade. The read timeout must outlast any
  # quiet spell of the socket, or nginx cuts it; the backend sends a heartbeat
  # every 10 s and the client reconnects after a cut.
  location = /ws {
    proxy_pass http://${BACKEND_UPSTREAM}/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
  }

  # Vite names every file under assets/ after a hash of its content, so a URL
  # never changes meaning and may be cached for good. A missing asset is a 404,
  # never index.html, so a browser cannot cache the page as a script.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Everything else is the app: any path that is not a file gets index.html,
  # which is revalidated on every load so a new build is picked up at once.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}

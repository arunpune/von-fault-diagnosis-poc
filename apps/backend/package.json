{
  "name": "@fdp/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Diagnosis backend: ingest, detection, retrieval, decision, gate, tickets, REST and WebSocket",
  "license": "Apache-2.0",
  "author": "Meddle S.r.l.",
  "repository": {
    "type": "git",
    "url": "https://github.com/meddleconnect/jev-fault-diagnosis-poc"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    "./pipeline": {
      "@fdp/source": "./src/pipeline/index.ts",
      "types": "./dist/pipeline/index.d.ts",
      "default": "./dist/pipeline/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && eslint . && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live": "vitest run --config vitest.integration.config.ts --mode live",
    "fixtures": "node --conditions=@fdp/source test/fixtures/telemetry/make-fixtures.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/websocket": "catalog:",
    "@fdp/contracts": "workspace:*",
    "@huggingface/tokenizers": "catalog:",
    "@typesafe-ai/sdk": "catalog:",
    "fastify": "catalog:",
    "mqtt": "catalog:",
    "onnxruntime-node": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fdp/db-migrate": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}

            "metropt3_check": { "$ref": "#/$defs/e3_metropt3_baseline" }
          },
          "required": ["gated", "review_diagnosis", "diagnosis", "metropt3_check"],
          "additionalProperties": false
        }
      },
      "required": ["name", "backend", "verdict", "failed", "not_covered", "conditions", "baseline"],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fdp:eval:report:v1",
  "title": "Evaluation report",
  "description": "run.json: one fdp-eval run, its backends, every scenario it replayed against every backend and the scores, the summary per backend and the core-10 gate, the tuning list of a --tuning run and, when the run was started with --exit-eval, every condition of that exit eval (read at detection level since 2026-09-24), when the run replayed the whole recording, its E6 summary, and, when a replayed scenario carries a design target, its reading, which is never gated. Instants are ISO 8601 UTC; a ratio with no denominator is null. No key, header, raw provider body or decision state is ever part of a report: a decision appears with its state_digest only.",
  "type": "object",
  "properties": {
    "schema": { "const": "urn:fdp:eval:report:v1" },
    "run": { "$ref": "#/$defs/run" },
    "backends": { "type": "array", "items": { "$ref": "#/$defs/backend" }, "minItems": 1 },
    "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenario" }, "minItems": 1 },
    "summary": { "oneOf": [{ "$ref": "#/$defs/summary" }, { "type": "null" }] },
    "gate": { "oneOf": [{ "$ref": "#/$defs/gate" }, { "type": "null" }] },
    "tuning": { "$ref": "#/$defs/tuning" },
    "exit_eval": { "$ref": "#/$defs/exit_eval" },
    "full_recording": {
      "type": "array",
      "items": { "$ref": "#/$defs/full_recording" },
      "minItems": 1
    },
    "design_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/design_reading" },
      "minItems": 1
    }
  },
  "required": ["schema", "run", "backends", "scenarios", "summary", "gate"],
  "additionalProperties": false,
  "$defs": {
    "instant": { "type": "string", "format": "date-time" },
    "optional_instant": { "type": ["string", "null"], "format": "date-time" },
    "ratio": { "type": ["number", "null"] },
    "count": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "backend_mode": { "enum": ["live", "cassette", "mock", "-"] },
    "level": { "enum": ["ticket", "review"] },
    "pass_level": { "enum": ["detection", "diagnosis"] },
    "suspect": {
      "type": "object",
      "description": "One suspect event detection raised: what detection level is scored on.",
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "sim_ts": { "$ref": "#/$defs/instant" },
        "symptom_key": { "type": "string", "minLength": 1 }
      },
      "required": ["event_id", "sim_ts", "symptom_key"],
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "description": "A scenario's suspect events read at detection level: the scored ones (after the warmup), the warmup's, those outside every positive span and excluded window, and each positive window's first suspect event in its credited span [span_from, to) with the budget's deadline.",
      "properties": {
        "suspects": { "$ref": "#/$defs/count" },
        "warmup_suspects": { "$ref": "#/$defs/count" },
        "outside_windows": { "$ref": "#/$defs/count" },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "window_id": { "type": "string", "minLength": 1 },
              "headline": { "type": "boolean" },
              "first_suspect": { "oneOf": [{ "$ref": "#/$defs/suspect" }, { "type": "null" }] },
              "deadline": { "$ref": "#/$defs/optional_instant" },
              "detected": { "type": "boolean" }
            },
            "required": ["window_id", "headline", "first_suspect", "deadline", "detected"],
            "additionalProperties": false
          }
        }
      },
      "required": ["suspects", "warmup_suspects", "outside_windows", "windows"],
      "additionalProperties": false
    },
    "design_target": {
      "type": "object",
      "description": "The scenario file's design target: the causes a diagnosis of its unlabelled episodes is read against. Reported, never scored or gated.",
      "properties": {
        "accepted": { "$ref": "#/$defs/ids" },
        "provenance": { "type": "string", "minLength": 1 }
      },
      "required": ["accepted", "provenance"],
      "additionalProperties": false
    },
    "design_level": {
      "type": "object",
      "properties": {
        "on_target": { "$ref": "#/$defs/count" },
        "off_target": { "$ref": "#/$defs/count" },
        "benign": { "$ref": "#/$defs/count" },
        "outside": { "$ref": "#/$defs/count" },
        "first": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ticket_id": { "type": "string", "minLength": 1 },
                "opened_sim_ts": { "$ref": "#/$defs/instant" },
                "fault_at_open": { "type": "string", "minLength": 1 }
              },
              "required": ["ticket_id", "opened_sim_ts", "fault_at_open"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "met": { "type": "boolean" }
      },
      "required": ["on_target", "off_target", "benign", "outside", "first", "met"],
      "additionalProperties": false
    },
    "design_reading": {
      "type": "object",
      "description": "One pair's tickets and decisions inside its scenario's unlabelled episodes, read against the scenario's design target. A report, never gated: no gate, exit eval, pass rule or threshold selection reads it.",
      "properties": {
        "scenario": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
        "backend": { "enum": ["rules", "von", "llm"] },
        "gated": { "const": false },
        "accepted": { "$ref": "#/$defs/ids" },
        "provenance": { "type": "string", "minLength": 1 },
        "episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/instant" },
              "to": { "$ref": "#/$defs/instant" }
            },
            "required": ["from", "to"],
            "additionalProperties": false
          }
        },
        "review": { "$ref": "#/$defs/design_level" },
        "ticket": { "$ref": "#/$defs/design_level" },
        "decisions": {
          "type": "object",
          "properties": {
            "total": { "$ref": "#/$defs/count" },
            "on_target": { "$ref": "#/$defs/count" },
            "by_choice": { "type": "object", "additionalProperties": { "$ref": "#/$defs/count" } }
          },
          "required": ["total", "on_target", "by_choice"],
          "additionalProperties": false
        }
      },
      "required": [
        "scenario",
        "backend",
        "gated",
        "accepted",
        "provenance",
        "episodes",
        "review",
        "ticket",
        "decisions"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{8}-\\d{6}-[a-z0-9][a-z0-9_-]*$" },
        "mode": { "enum": ["in_process", "stack"] },
        "profile": { "type": "string", "minLength": 1 },
        "scenario_filter": { "$ref": "#/$defs/ids" },
        "started_wall_ts": { "$ref": "#/$defs/instant" },
        "finished_wall_ts": { "$ref": "#/$defs/instant" },
        "git_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "node": { "type": "string", "minLength": 1 },
        "backend_version": { "type": "string", "minLength": 1 },
        "ground_truth": {
          "type": "object",
          "properties": {
            "package_version": { "type": "string", "minLength": 1 },
            "failures_sha256": { "$ref": "#/$defs/sha256" },
            "injections_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
          },
          "required": ["package_version", "failures_sha256", "injections_sha256"],
          "additionalProperties": false
        },
        "catalog": {
          "type": "object",
          "description": "The catalog the retriever ranked: reference is the ablation, file:<path> the catalog extracted from the realistic PDF.",
          "properties": {
            "source": { "enum": ["reference", "file", "ingested"] },
            "name": { "type": "string", "pattern": "^(reference|ingested|file:.+)$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "entries": { "$ref": "#/$defs/count" },
            "faults": { "$ref": "#/$defs/count" }
          },
          "required": ["source", "name", "sha256", "entries", "faults"],
          "additionalProperties": false
        },
        "alarm_registry": {
          "type": "object",
          "properties": {
            "source": { "enum": ["manual", "provisional", "off"] },
            "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
          },
          "required": ["source", "sha256"],
          "additionalProperties": false
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "ticket_min": {
              "description": "GATE_TICKET_MIN_CONFIDENCE, the global ticket threshold; a backend with its own pair (von) states it in backends[].thresholds.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "review_min": {
              "description": "GATE_REVIEW_MIN_CONFIDENCE, the global review threshold; a backend with its own pair (von) states it in backends[].thresholds.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "decision_interval_sim_min": { "type": "number", "exclusiveMinimum": 0 },
            "episode_clear_sim_min": { "type": "number", "exclusiveMinimum": 0 },
            "persist_sim_min": {
              "description": "GATE_PERSIST_SIM_MIN: sim minutes of unbroken evidence before an episode that owns no ticket is decided. Absent from reports written before it existed.",
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "ticket_min",
            "review_min",
            "decision_interval_sim_min",
            "episode_clear_sim_min"
          ],
          "additionalProperties": false
        },
        "rules_disabled": { "$ref": "#/$defs/ids" },
        "prices": {
          "type": "object",
          "properties": {
            "von_input_per_mtok": { "type": "number", "minimum": 0 },
            "llm_input_per_mtok": { "type": "number", "minimum": 0 },
            "llm_output_per_mtok": { "type": "number", "minimum": 0 },
            "as_of": { "type": "string", "format": "date" }
          },
          "required": ["von_input_per_mtok", "llm_input_per_mtok", "llm_output_per_mtok", "as_of"],
          "additionalProperties": false
        },
        "seed": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": [
        "id",
        "mode",
        "profile",
        "scenario_filter",
        "started_wall_ts",
        "finished_wall_ts",
        "git_sha",
        "node",
        "backend_version",
        "ground_truth",
        "catalog",
        "alarm_registry",
        "thresholds",
        "rules_disabled",
        "prices",
        "seed"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "properties": {
        "name": { "enum": ["rules", "von", "llm"] },
        "model": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/backend_mode" },
        "informative": {
          "description": "False for a mock column, whose answers say nothing about the model, and for a backend whose every decision failed.",
          "type": "boolean"
        },
        "calls": { "$ref": "#/$defs/count" },
        "failures": { "$ref": "#/$defs/count" },
        "failure_reasons": {
          "description": "Why the failed decisions failed, as '<kind>: <message>' with a count, most frequent first; empty when none did. The message is the backend's own sentence, never a provider body. Optional so that a report written before it existed still validates.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reason": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 }
            },
            "required": ["reason", "count"],
            "additionalProperties": false
          }
        },
        "cassette_hits": { "$ref": "#/$defs/count" },
        "cassette_misses": { "$ref": "#/$defs/count" },
        "cassette_miss_digests": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "cassette_reused": {
          "description": "Cassette hits past the last answer their cassette recorded, answered with that answer again: the recording kept fewer answers of the request than the run asked for, so those decisions need not be the live run's. Optional so that a report written before it existed still validates.",
          "$ref": "#/$defs/count"
        },
        "cassette_resample": {
          "description": "--resample: which rotation of each repeated request's recorded answers the cassette server served; 0 is the recording's own order. Cassette mode only; optional so that a report written before it existed still validates.",
          "$ref": "#/$defs/count"
        },
        "cassette_answers_max": {
          "description": "The most recorded answers any cassette the run hit held: how many resamples the recording can give (the pre-registered sweep replays that many). Cassette mode only; optional so that a report written before it existed still validates.",
          "$ref": "#/$defs/count"
        },
        "thresholds": {
          "description": "The pair the gate applied to this backend's decisions: VON_GATE_* for von (0.85 / 0.65 by default, the pre-registered choice; a run made before Von had its own default pair defaulted each to its GATE_* twin), GATE_* for rules and llm. Optional so that a report written before it existed still validates; run.thresholds then holds the pair every backend used.",
          "type": "object",
          "properties": {
            "ticket_min": { "type": "number", "minimum": 0, "maximum": 1 },
            "review_min": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["ticket_min", "review_min"],
          "additionalProperties": false
        },
        "rate_limit": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "calls": { "$ref": "#/$defs/count" },
                "retries": { "$ref": "#/$defs/count" },
                "waited_ms": { "type": "number", "minimum": 0 }
              },
              "required": ["calls", "retries", "waited_ms"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "name",
        "model",
        "mode",
        "informative",
        "calls",
        "failures",
        "cassette_hits",
        "cassette_misses",
        "cassette_miss_digests",
        "rate_limit"
      ],
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/instant" },
        "to": { "$ref": "#/$defs/instant" },
        "lead_from": { "$ref": "#/$defs/instant" },
        "accepted": { "$ref": "#/$defs/ids" },
        "benign": { "type": "boolean" },
        "onset": { "$ref": "#/$defs/optional_instant" },
        "onset_known": { "type": "boolean" },
        "native_lps_first": { "$ref": "#/$defs/optional_instant" },
        "headline": { "type": "boolean" }
      },
      "required": [
        "id",
        "from",
        "to",
        "lead_from",
        "accepted",
        "benign",
        "onset",
        "onset_known",
        "native_lps_first",
        "headline"
      ],
      "additionalProperties": false
    },
    "excluded": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/instant" },
        "to": { "$ref": "#/$defs/instant" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "from", "to", "reason"],
      "additionalProperties": false
    },
    "ticket": {
      "type": "object",
      "properties": {
        "ticket_id": { "type": "string", "minLength": 1 },
        "episode_id": { "type": "string", "minLength": 1 },
        "opened_sim_ts": { "$ref": "#/$defs/instant" },
        "fault_at_open": { "type": "string", "minLength": 1 },
        "fault_latest": { "type": "string", "minLength": 1 },
        "max_level": { "$ref": "#/$defs/level" },
        "closed_sim_ts": { "$ref": "#/$defs/optional_instant" },
        "open_at_end": { "type": "boolean" },
        "verdict": {
          "enum": [
            "tp",
            "recovered",
            "duplicate",
            "misdiagnosed",
            "fp",
            "ignored",
            "benign",
            "warmup"
          ]
        },
        "window_id": { "type": ["string", "null"] }
      },
      "required": [
        "ticket_id",
        "episode_id",
        "opened_sim_ts",
        "fault_at_open",
        "fault_latest",
        "max_level",
        "closed_sim_ts",
        "open_at_end",
        "verdict",
        "window_id"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" }
      },
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "episode_id": { "type": "string", "minLength": 1 },
        "sim_ts": { "$ref": "#/$defs/instant" },
        "choice": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "gate": { "enum": ["ticket", "review", "log"] },
        "abstained": { "type": "boolean" },
        "benign_choice": { "type": "boolean" },
        "usage": { "$ref": "#/$defs/usage" },
        "backend": { "type": "string", "minLength": 1 },
        "state_digest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "persisted_sim_min": {
          "description": "How long the episode's own symptom had fired without a break when the decision was taken, in sim minutes: the threshold sweep never lets a decision below GATE_PERSIST_SIM_MIN open a ticket. Optional so that a report written before it existed still validates.",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "decision_id",
        "episode_id",
        "sim_ts",
        "choice",
        "confidence",
        "gate",
        "abstained",
        "benign_choice",
        "usage",
        "backend",
        "state_digest"
      ],
      "additionalProperties": false
    },
    "fault_score": {
      "type": "object",
      "properties": {
        "tp": { "$ref": "#/$defs/count" },
        "fp": { "$ref": "#/$defs/count" },
        "fn": { "$ref": "#/$defs/count" },
        "windows": { "$ref": "#/$defs/count" },
        "precision": { "$ref": "#/$defs/ratio" },
        "recall": { "$ref": "#/$defs/ratio" }
      },
      "required": ["tp", "fp", "fn", "windows", "precision", "recall"],
      "additionalProperties": false
    },
    "precision_recall": {
      "type": "object",
      "properties": {
        "level": { "$ref": "#/$defs/level" },
        "per_fault": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/fault_score" }
        },
        "micro": { "$ref": "#/$defs/fault_score" },
        "macro": {
          "type": "object",
          "properties": {
            "precision": { "$ref": "#/$defs/ratio" },
            "recall": { "$ref": "#/$defs/ratio" },
            "precision_faults": { "$ref": "#/$defs/count" },
            "recall_faults": { "$ref": "#/$defs/count" }
          },
          "required": ["precision", "recall", "precision_faults", "recall_faults"],
          "additionalProperties": false
        }
      },
      "required": ["level", "per_fault", "micro", "macro"],
      "additionalProperties": false
    },
    "precision_recall_levels": {
      "type": "object",
      "properties": {
        "ticket": { "$ref": "#/$defs/precision_recall" },
        "review": { "$ref": "#/$defs/precision_recall" }
      },
      "required": ["ticket", "review"],
      "additionalProperties": false
    },
    "match_counts": {
      "type": "object",
      "properties": {
        "tp": { "$ref": "#/$defs/count" },
        "fp": { "$ref": "#/$defs/count" },
        "fn": { "$ref": "#/$defs/count" },
        "misdiagnosed": { "$ref": "#/$defs/count" },
        "recovered": { "$ref": "#/$defs/count" },
        "duplicates": { "$ref": "#/$defs/count" },
        "ignored": { "$ref": "#/$defs/count" },
        "benign": { "$ref": "#/$defs/count" }
      },
      "required": [
        "tp",
        "fp",
        "fn",
        "misdiagnosed",
        "recovered",
        "duplicates",
        "ignored",
        "benign"
      ],
      "additionalProperties": false
    },
    "lead_time": {
      "type": "object",
      "properties": {
        "window_id": { "type": "string", "minLength": 1 },
        "fault": { "type": "string", "minLength": 1 },
        "first_correct_ticket": { "$ref": "#/$defs/instant" },
        "native_code": { "type": ["string", "null"] },
        "native_first": { "$ref": "#/$defs/optional_instant" },
        "lead_minutes": { "$ref": "#/$defs/ratio" },
        "lps_first": { "$ref": "#/$defs/optional_instant" },
        "lps_lead_minutes": { "$ref": "#/$defs/ratio" },
        "latency_minutes": { "type": "number" },
        "qualifier": { "enum": ["", ">="] }
      },
      "required": [
        "window_id",
        "fault",
        "first_correct_ticket",
        "native_code",
        "native_first",
        "lead_minutes",
        "lps_first",
        "lps_lead_minutes",
        "latency_minutes",
        "qualifier"
      ],
      "additionalProperties": false
    },
    "rates": {
      "type": "object",
      "properties": {
        "tickets": { "$ref": "#/$defs/count" },
        "false_tickets": { "$ref": "#/$defs/count" },
        "covered_machine_days": { "type": "number", "minimum": 0 },
        "negative_machine_days": { "type": "number", "minimum": 0 },
        "tickets_per_machine_day": { "$ref": "#/$defs/ratio" },
        "false_tickets_per_machine_day": { "$ref": "#/$defs/ratio" }
      },
      "required": [
        "tickets",
        "false_tickets",
        "covered_machine_days",
        "negative_machine_days",
        "tickets_per_machine_day",
        "false_tickets_per_machine_day"
      ],
      "additionalProperties": false
    },
    "abstention": {
      "type": "object",
      "properties": {
        "correct": { "$ref": "#/$defs/count" },
        "total": { "$ref": "#/$defs/count" },
        "accuracy": { "$ref": "#/$defs/ratio" },
        "decisions": { "$ref": "#/$defs/count" },
        "explicit": { "$ref": "#/$defs/count" },
        "explicit_rate": { "$ref": "#/$defs/ratio" },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "correct": { "type": "boolean" },
              "reasons": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "correct", "reasons"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "correct",
        "total",
        "accuracy",
        "decisions",
        "explicit",
        "explicit_rate",
        "cases"
      ],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "usd": { "type": "number", "minimum": 0 },
